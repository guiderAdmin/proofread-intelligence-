# Persistent database
MONGODB_URI=mongodb://127.0.0.1:27017/proofdesk

# AI provider (keep server-side; never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=low
# One page request; no automatic revisit, crops, fallback or retries.
# This cap includes response and thinking tokens; unused allowance is not billed.
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TIER=free
PAGE_BATCH=1
GEMINI_REQUEST_TIMEOUT_MS=35000
PAGE_PROCESSING_TIMEOUT_MS=300000

# Cost-bounded chapter memory. Every chapter page is represented inside the
# input budget; the cached result is reused by all page analyses.
CHAPTER_MAX_INPUT_CHARS=32000
CHAPTER_MAX_MEMORY_CALLS=2
CHAPTER_INDEX_MAX_CHARS_PER_CALL=18000
CHAPTER_MAX_OUTPUT_TOKENS=1600
CHAPTER_CONTEXT_MAX_CHARS=4500
CHAPTER_REQUEST_TIMEOUT_MS=30000
# auto = attach chapter PDF pages only when extracted text is too sparse.
CHAPTER_VISUAL_INDEXING=auto

# Cloudinary temporary upload bucket
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Persistent local storage used by the standalone Next.js server
PROOFDESK_STORAGE_DIR=

# Optional application-wide HTTP Basic authentication. Configure both values
# in production and serve the application only over HTTPS.
PROOFDESK_BASIC_USER=
PROOFDESK_BASIC_PASSWORD=

# Optional local Tesseract executable for scanned PDFs and embedded diagram text.
# Install Tesseract plus required trained language data on the analysis server.
OCR_ENABLED=true
TESSERACT_CMD=tesseract
# Override automatic book-language mapping; multiple codes may use eng+hin.
OCR_LANGUAGE=
OCR_TIMEOUT_MS=30000

# Optional local or hosted language-data directory for the isolated JS OCR worker.
OCR_LANG_PATH=
